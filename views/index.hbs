<html lang='es'>
  <head>
    <meta charset='UTF-8' />
    <meta name='viewport' content='width=device-width, initial-scale=1.0' />
    <title>Eventy</title>
    <link rel='icon' href='logo.png' type='image/png' />

    <link
      href='https://cdn.jsdelivr.net/npm/bootstrap@5.3.0-alpha1/dist/css/bootstrap.min.css'
      rel='stylesheet'
    />

    <style>
      .hero-section { background-color: rgba(0, 0, 0, 0.5); height: 100vh;
      color: #fff; } .footer { background-color: #212529; color: #fff; padding:
      3rem 0; text-align: center; }
    </style>
  </head>
  <body>

    <!-- Navbar -->
    <nav class='navbar navbar-expand-lg navbar-dark bg-dark fixed-top'>
      <div class='container-fluid'>
        <a class='navbar-brand d-flex align-items-center' href='/'>
          <img
            src='logo.png'
            alt='Logo de la Web'
            width='40'
            height='40'
            class='me-2'
          />
          Eventy
        </a>
        <button class='btn btn-primary' onclick="window.location.href='/login'">
          Iniciar sesión
        </button>
      </div>
    </nav>

    <!-- Sección Hero -->
    <div
      class='d-flex flex-column align-items-center justify-content-center text-center hero-section'
    >
      <h1 class='display-4 fw-bold'>Organiza y reserva tus eventos favoritos</h1>
      <p class='lead'>Una plataforma fácil, rápida y moderna para gestionar
        eventos y espacios físicos.</p>
    </div>

    <!-- Contenido principal -->
    <div class='container my-5' id='funcionalidades'>
      <h2 class='text-center'>Explora nuestras funcionalidades</h2>
      <p class='lead text-center'>
        Aquí podrás gestionar espacios físicos y eventos. También realizar
        reservas de los eventos.
      </p>
    </div>

    <!-- Footer -->
    <footer class='footer'>
      <p>&copy; 2025 Eventy. Todos los derechos reservados.</p>
      <p>Creado por: <strong>ElManueh</strong> y <strong>Julisco23</strong></p>
    </footer>

  </body>
</html>