<!DOCTYPE html>
<html lang="es">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0"/>
  <title>Eventy</title>
  <link rel="icon" href="public/logo.png" type="image/png" />

  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0-alpha1/dist/css/bootstrap.min.css" rel="stylesheet" />

  <style>
    body, html {
      margin: 0;
      padding: 0;
      height: 100%;
      overflow-x: hidden;
    }

    .video-section {
      position: relative;
      width: 100%;
      height: 100vh;
      overflow: hidden;
    }

    .fullscreen-video {
      position: absolute;
      top: 50%;
      left: 50%;
      min-width: 100%;
      min-height: 100%;
      width: auto;
      height: auto;
      transform: translate(-50%, -50%);
      z-index: -1;
    }

    .footer {
      background-color: #212529;
      color: #fff;
      padding: 2rem 0;
      text-align: center;
    }

    .navbar .btn {
      margin-left: auto;
    }
  </style>
</head>
<body>

  <!-- Navbar -->
  <nav class="navbar navbar-expand-lg navbar-dark bg-dark fixed-top">
    <div class="container-fluid">
      <a class="navbar-brand" href="/">
        <img src="public/logo.png" alt="Logo de la Web" width="40" height="40" />
      </a>

      <a class="navbar-brand" href="#">Eventy</a>

      <button class="btn btn-primary" onclick="window.location.href='/login'">
        Iniciar sesión
      </button>
    </div>
  </nav>

  <!-- Sección de video -->
  <div class="video-section">
    <video autoplay muted loop class="fullscreen-video">
      <source src="https://www.w3schools.com/html/mov_bbb.mp4" type="video/mp4" />
      Tu navegador no soporta el formato de video.
    </video>
  </div>

  <!-- Contenido principal -->
  <div class="container my-5">
    <h2 class="text-center">Explora nuestras funcionalidades</h2>
    <p class="lead text-center">
      Aquí podrás gestionar espacios físicos y eventos. También realizar reservas de los eventos.
    </p>
  </div>

  <!-- Footer -->
  <footer class="footer">
    <p>&copy; 2025 Eventy. Todos los derechos reservados.</p>
    <p>Creado por: <strong>ElManueh</strong> y <strong>Julisco23</strong></p>
    <p>
      <a href="#" class="text-white">Política de privacidad</a> |
      <a href="#" class="text-white">Términos y condiciones</a>
    </p>
  </footer>

</body>
</html>
